# ==============================================================================
# Asha Tensile Structures - Production .htaccess Configuration (Hostinger / LiteSpeed / Apache)
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirect legacy URL with trailing space to clean URL
    RewriteRule ^architecturalMembraneIntroduction\s*\.html$ https://www.ashatensilestructures.in/architecturalMembraneIntroduction.html [R=301,L]

    # 2. Enforce HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. Enforce Preferred WWW Canonical Domain
    RewriteCond %{HTTP_HOST} ^ashatensilestructures\.in$ [NC]
    RewriteRule ^(.*)$ https://www.ashatensilestructures.in/$1 [L,R=301]

    # 4. Normalize index.html to root for homepage
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
    RewriteRule ^index\.html$ https://www.ashatensilestructures.in/ [R=301,L]
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html

# ==============================================================================
# Security Headers
# ==============================================================================
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"

    # Cross-site scripting filter
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unnecessary browser features
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HTTP Strict Transport Security (HSTS)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ==============================================================================
# Compression (Gzip / Deflate)
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ==============================================================================
# Browser Caching (Expires & Cache-Control)
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Media & Images (1 year)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Web Fonts (1 year)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"

    # CSS & JavaScript (1 month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # HTML Documents (1 hour)
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Explicit Cache-Control Headers for Apache / LiteSpeed / Hostinger
<IfModule mod_headers.c>
    # 1 Year for Media, Images, and Web Fonts
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|svg|woff|woff2|eot|ttf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    # 1 Month for CSS and JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    # 1 Hour for HTML Documents
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=3600, public, must-revalidate"
    </FilesMatch>
</IfModule>
